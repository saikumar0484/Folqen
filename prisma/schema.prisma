// Folqen - Prisma Schema
// Phase 4: Full database schema with all models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// ENUMS
// =====================

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum ContentStatus {
  IDEA
  RESEARCHING
  SCRIPTING
  STORYBOARDING
  GENERATING
  RENDERING
  REVIEWING
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  FAILED
}

enum TaskStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  DEFERRED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PlatformName {
  YOUTUBE
  INSTAGRAM
  FACEBOOK
  SNAPCHAT
  THREADS
  SUBSTACK
  LINKEDIN
  BLUESKY
  LEMON8
  KICK
}

enum ToolType {
  LLM
  IMAGE_GEN
  VIDEO_GEN
  VOICE_GEN
  TRANSCRIPTION
  CAPTION
  RENDER
  WORKFLOW
  ANALYTICS
  STORAGE
  BROWSER
}

enum ConnectionStatus {
  NOT_CONNECTED
  CONFIGURED
  TESTING
  LIVE
  FAILED
  DISABLED
  DEPRECATED
  NEEDS_ATTENTION
}

enum ReviewStatus {
  NOT_REVIEWED
  PASSED
  FAILED
  NEEDS_REVISION
}

enum ProviderStatus {
  NOT_CONNECTED
  CONFIGURED
  LIVE
  FAILED
  DISABLED
  MOCK
}

enum UpgradeStatus {
  RESEARCHING
  DRAFTED
  NEEDS_HUMAN_REVIEW
  APPROVED
  REJECTED
  TESTING
  IMPLEMENTED
  ROLLED_BACK
  DEFERRED
}

// =====================
// MODELS
// =====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          UserRole  @default(VIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agentMessages  AgentMessage[]
  agentTasks     AgentTask[]
  approvals      Approval[]
  auditLogs      AuditLog[]
  notifications  Notification[]
}

model AgentMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // 'user' | 'assistant' | 'system'
  content   String
  pageContext String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AgentTask {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  progress    Int        @default(0)
  logs        Json       @default("[]")
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ContentItem {
  id              String        @id @default(cuid())
  title           String
  topic           String?
  niche           String        @default("Urban Legends")
  status          ContentStatus @default(IDEA)
  platform        PlatformName?
  format          String?       // 'short', 'long', 'reel', 'story', 'thread'
  script          String?
  storyboard      String?
  reviewStatus    ReviewStatus  @default(NOT_REVIEWED)
  safetyStatus    String        @default("pending")
  copyrightStatus String        @default("pending")
  approvalStatus  ApprovalStatus @default(PENDING)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assets    Asset[]
  renders   Render[]
  approvals Approval[]
}

model Asset {
  id            String   @id @default(cuid())
  contentItemId String?
  name          String
  type          String   // 'image', 'video', 'audio', 'thumbnail', 'caption'
  url           String
  size          Int?
  mimeType      String?
  isPublic      Boolean  @default(false)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  contentItem ContentItem? @relation(fields: [contentItemId], references: [id])
}

model Render {
  id            String     @id @default(cuid())
  contentItemId String?
  status        TaskStatus @default(PENDING)
  provider      String     @default("ffmpeg")
  inputFiles    Json       @default("[]")
  outputFile    String?
  logs          Json       @default("[]")
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())

  contentItem ContentItem? @relation(fields: [contentItemId], references: [id])
}

model Approval {
  id            String         @id @default(cuid())
  userId        String
  type          String         // 'publish', 'paid_tool', 'sensitive_topic', 'upgrade', 'account_connect'
  title         String
  description   String?
  status        ApprovalStatus @default(PENDING)
  riskLevel     RiskLevel      @default(MEDIUM)
  contentItemId String?
  metadata      Json           @default("{}")
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id])
}

model PlatformConnection {
  id              String           @id @default(cuid())
  platform        PlatformName
  status          ConnectionStatus @default(NOT_CONNECTED)
  apiMode         Boolean          @default(false)
  lastPost        DateTime?
  failedPosts     Int              @default(0)
  config          Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([platform])
}

model ToolLimit {
  id           String     @id @default(cuid())
  name         String
  type         ToolType
  status       ProviderStatus @default(NOT_CONNECTED)
  usedToday    Int        @default(0)
  limitPerDay  Int?
  usedMonth    Int        @default(0)
  limitPerMonth Int?
  costPerUnit  Float?     @default(0)
  isLocal      Boolean    @default(true)
  isPaid       Boolean    @default(false)
  config       Json       @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AnalyticsRecord {
  id           String       @id @default(cuid())
  platform     PlatformName
  date         DateTime
  views        Int          @default(0)
  watchTime    Int          @default(0)
  retention    Float?
  ctr          Float?
  engagement   Int          @default(0)
  subscribers  Int?
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   Json     @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model UploadedFile {
  id        String   @id @default(cuid())
  name      String
  originalName String
  mimeType  String
  size      Int
  path      String
  isPublic  Boolean  @default(false)
  uploadedBy String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
}

model ErrorLog {
  id         String   @id @default(cuid())
  source     String
  message    String
  stack      String?
  resolved   Boolean  @default(false)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // 'info', 'warning', 'error', 'success'
  read      Boolean  @default(false)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model WorkflowRun {
  id          String     @id @default(cuid())
  provider    String     @default("n8n")
  workflowId  String?
  status      TaskStatus @default(PENDING)
  trigger     String?
  payload     Json       @default("{}")
  result      Json       @default("{}")
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
}

model UpgradeProposal {
  id               String        @id @default(cuid())
  title            String
  summary          String
  category         String
  reason           String?
  currentProblem   String?
  proposedSolution String?
  expectedBenefit  String?
  estimatedCostInr Float         @default(0)
  freeAlternative  String?
  difficulty       String        @default("medium")
  securityRisk     String        @default("low")
  rollbackPlan     String?
  testingPlan      String?
  affectedAreas    Json          @default("[]")
  requiredApprovals Json         @default("[]")
  agentRecommendation String?
  confidenceScore  Float         @default(0.5)
  status           UpgradeStatus @default(RESEARCHING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  researchFindings ResearchFinding[]
  upgradeRuns      UpgradeRun[]
}

model ResearchFinding {
  id                String   @id @default(cuid())
  upgradeProposalId String?
  title             String
  summary           String
  source            String?
  category          String
  relevanceScore    Float    @default(0.5)
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())

  upgradeProposal UpgradeProposal? @relation(fields: [upgradeProposalId], references: [id])
}

model UpgradeRun {
  id                String        @id @default(cuid())
  upgradeProposalId String
  status            UpgradeStatus @default(TESTING)
  branch            String?
  logs              Json          @default("[]")
  result            String?
  rolledBack        Boolean       @default(false)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime      @default(now())

  upgradeProposal UpgradeProposal @relation(fields: [upgradeProposalId], references: [id])
}

model ProviderRegistryItem {
  id           String         @id @default(cuid())
  providerId   String         @unique
  name         String
  type         String
  status       ProviderStatus @default(NOT_CONNECTED)
  version      String?
  capabilities Json           @default("[]")
  costModel    Json           @default("{}")
  config       Json           @default("{}")
  isLocal      Boolean        @default(false)
  isPaid       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model PromptVersion {
  id        String   @id @default(cuid())
  name      String
  category  String
  version   Int      @default(1)
  content   String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
}

model EventLog {
  id        String   @id @default(cuid())
  type      String
  entityId  String?
  entityType String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
}
