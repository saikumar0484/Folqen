# Folqen safe defaults
ALLOW_PUBLIC_PUBLISH=false
REQUIRE_HUMAN_APPROVAL=true
ALLOW_PAID_TOOLS=false
ALLOW_BROWSER_AUTOMATION=false
DEFAULT_UPLOAD_PRIVACY=private

# Database
DATABASE_URL="postgresql://folqen:folqen_password@localhost:5432/folqen?schema=public"

# Auth and credential vault placeholders - replace before production
AUTH_SECRET="replace-with-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
CREDENTIAL_ENCRYPTION_KEY=""

# Local/free tool placeholders
REDIS_URL="redis://localhost:6379"
BULLMQ_PREFIX="folqen"
ORCHESTRATION_EXECUTION_MODE="mock"
ORCHESTRATION_WORKER_ENABLED=false
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
ORACLE_N8N_INSTANCE_URL=""
LOCAL_WORKER_BASE_URL=""
LOCAL_WORKER_SHARED_SECRET=""
COMFYUI_BASE_URL=""
FFMPEG_PATH="ffmpeg"
TTS_PROVIDER_URL=""

# Google Drive storage placeholders - keep real values out of git
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# OpenAI placeholders - keep real key out of git
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# Self-improvement defaults
SELF_IMPROVEMENT_ENABLED=true
DAILY_RESEARCH_SCAN=true
WEEKLY_UPGRADE_REPORT=true
MONTHLY_ARCHITECTURE_REVIEW=true
AUTO_EXECUTE_UPGRADES=false
REQUIRE_UPGRADE_APPROVAL=true
ALLOW_PAID_RESEARCH_TOOLS=false
MAX_MONTHLY_RESEARCH_COST_INR=0
