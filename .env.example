# Folqen Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# =====================
# DATABASE
# =====================
DATABASE_URL="postgresql://folqen:folqen_password@localhost:5432/folqen_db"

# =====================
# NEXTAUTH
# =====================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-32-char-secret"

# =====================
# SECURITY DEFAULTS (DO NOT CHANGE WITHOUT APPROVAL)
# =====================
ALLOW_PUBLIC_PUBLISH=false
REQUIRE_HUMAN_APPROVAL=true
ALLOW_PAID_TOOLS=false
ALLOW_BROWSER_AUTOMATION=false
DEFAULT_UPLOAD_PRIVACY=private

# =====================
# SELF IMPROVEMENT AGENT
# =====================
SELF_IMPROVEMENT_ENABLED=true
DAILY_RESEARCH_SCAN=true
WEEKLY_UPGRADE_REPORT=true
MONTHLY_ARCHITECTURE_REVIEW=true
AUTO_EXECUTE_UPGRADES=false
REQUIRE_UPGRADE_APPROVAL=true
ALLOW_PAID_RESEARCH_TOOLS=false
MAX_MONTHLY_RESEARCH_COST_INR=0

# =====================
# N8N INTEGRATION (optional - configure in Settings)
# =====================
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# =====================
# AI PROVIDERS (optional - configure in Settings)
# =====================
# OpenAI (NOT connected by default)
OPENAI_API_KEY=

# =====================
# APP SETTINGS
# =====================
NEXT_PUBLIC_APP_NAME="Folqen"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
